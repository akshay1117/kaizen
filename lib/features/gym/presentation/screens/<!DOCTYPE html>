<body class="bg-background text-on-background min-h-screen pb-[98px]">
<!-- Header (Web) -->
<header class="hidden md:flex justify-between items-center px-container-padding py-base w-full sticky top-0 z-50 bg-surface/80 backdrop-blur-md">
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-primary dark:text-primary">menu</span>
<h1 class="font-headline-lg text-headline-lg text-primary-fixed-dim">Dashboard</h1>
</div>
<div>
<img alt="User profile photo" class="w-10 h-10 rounded-full object-cover border border-surface-container-high" data-alt="A close-up portrait of a fit athlete with a serious, determined expression, dramatic studio lighting against a dark background, showcasing intense focus for a high-end fitness app profile picture." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBrgK2Aax3UCZOyqParioV86Re1VE4kkypmGb5a6BRiJtB2Jf0bjiKcdSAeHeRDClS9Js0-cTEOOo2X36pH-IUWI1lo8V9QobavJxYp-bqziP9OZmGXZ4Ubxa8Tfcs_5cNexUq_o69AeEi9OfD70o-Ieb2O5qwLo5lKkV5BKpAbaK0uvJO0VQ46vg77NtX-ZUk_9KDFzHqW-JGhPq8ZQeDktn9TJoVY4t51mJcQQTfJ1z_Dwjjspr_9uDKhXeU6baljE_QhW4ztGyM"/>
</div>
</header>
<!-- Main Content -->
<main class="max-w-4xl mx-auto md:pt-8">
<!-- Header (Mobile) -->
<div class="px-container-padding py-6 md:hidden">
<h1 class="font-display-xl text-display-xl text-primary">Today</h1>
</div>
<!-- Desktop Title -->
<div class="hidden md:block px-container-padding py-6">
<h1 class="font-display-xl text-display-xl text-primary">Activity Overview</h1>
</div>
<!-- Date Selector -->
<section class="mb-section-margin overflow-hidden relative">
<div class="flex gap-4 px-container-padding overflow-x-auto hide-scrollbar pb-4 snap-x">
<!-- Day -2 -->
<button class="flex flex-col items-center justify-center w-[72px] h-[88px] rounded-2xl bg-surface-container-low text-on-surface-variant flex-shrink-0 snap-start transition-colors">
<span class="font-label-caps text-label-caps mb-1">TUE</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile">22</span>
</button>
<!-- Day -1 -->
<button class="flex flex-col items-center justify-center w-[72px] h-[88px] rounded-2xl bg-surface-container-low text-on-surface-variant flex-shrink-0 snap-start transition-colors">
<span class="font-label-caps text-label-caps mb-1">WED</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile">23</span>
</button>
<!-- Active Day -->
<button class="flex flex-col items-center justify-center w-[72px] h-[88px] rounded-2xl bg-primary-fixed-dim text-on-primary-fixed flex-shrink-0 snap-start glow-active">
<span class="font-label-caps text-label-caps mb-1">THU</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile">24</span>
</button>
<!-- Day +1 -->
<button class="flex flex-col items-center justify-center w-[72px] h-[88px] rounded-2xl bg-surface-container-low text-on-surface-variant flex-shrink-0 snap-start transition-colors">
<span class="font-label-caps text-label-caps mb-1">FRI</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile">25</span>
</button>
<!-- Day +2 -->
<button class="flex flex-col items-center justify-center w-[72px] h-[88px] rounded-2xl bg-surface-container-low text-on-surface-variant flex-shrink-0 snap-start transition-colors">
<span class="font-label-caps text-label-caps mb-1">SAT</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile">26</span>
</button>
<!-- Day +3 -->
<button class="flex flex-col items-center justify-center w-[72px] h-[88px] rounded-2xl bg-surface-container-low text-on-surface-variant flex-shrink-0 snap-start transition-colors pr-[15%] box-content">
<span class="font-label-caps text-label-caps mb-1">SUN</span>
<span class="font-headline-lg-mobile text-headline-lg-mobile">27</span>
</button>
</div>
<!-- Gradient fade for scroll indication -->
<div class="absolute right-0 top-0 bottom-4 w-12 bg-gradient-to-l from-background to-transparent pointer-events-none md:hidden"></div>
</section>
<!-- Metrics Grid -->
<section class="px-container-padding mb-section-margin">
<div class="grid grid-cols-2 gap-stack-gap">
<!-- Card 1: Sets -->
<div class="glass-panel rounded-xl p-5 flex flex-col justify-between aspect-square relative overflow-hidden group">
<div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase z-10">Sets</span>
<div class="mt-auto z-10">
<span class="font-metric-huge text-metric-huge text-primary">4</span>
</div>
</div>
<!-- Card 2: Repetitions -->
<div class="glass-panel rounded-xl p-5 flex flex-col justify-between aspect-square relative overflow-hidden group">
<div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase z-10">Repetitions</span>
<div class="mt-auto z-10">
<span class="font-metric-huge text-metric-huge text-primary">48</span>
</div>
</div>
<!-- Card 3: Volume -->
<div class="glass-panel rounded-xl p-5 flex flex-col justify-between aspect-square relative overflow-hidden group">
<div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase z-10">Volume</span>
<div class="mt-auto z-10 flex items-baseline gap-1">
<span class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-primary">1,080</span>
<span class="font-body-md text-body-md text-on-surface-variant">kg</span>
</div>
</div>
<!-- Card 4: Avg Rest -->
<div class="glass-panel rounded-xl p-5 flex flex-col justify-between aspect-square relative overflow-hidden group">
<div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
<span class="font-label-caps text-label-caps text-on-surface-variant uppercase z-10">Avg Rest</span>
<div class="mt-auto z-10 flex items-baseline gap-1">
<span class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-primary">18</span>
<span class="font-body-md text-body-md text-on-surface-variant">s</span>
</div>
</div>
</div>
</section>
<!-- Action Area -->
<section class="px-container-padding flex justify-center mb-section-margin">
<button class="bg-primary-fixed-dim text-on-primary-fixed font-label-caps text-label-caps py-4 px-8 rounded-full uppercase tracking-widest hover:bg-white transition-colors glow-active">
                Start Next Session
            </button>
</section>
</main>
<!-- Bottom Navigation Shell -->
<nav class="md:hidden fixed bottom-0 w-full z-50 pb-[34px] bg-surface/80 dark:bg-surface/80 backdrop-blur-xl border-t border-white/10">
<div class="flex justify-around items-center h-16 w-full px-container-padding">
<!-- Active Tab: Today -->
<button class="flex flex-col items-center justify-center text-primary-fixed-dim after:content-[''] after:w-1 after:h-1 after:bg-primary-fixed-dim after:rounded-full after:mt-1 active:scale-90 transition-transform hover:text-primary-fixed-dim transition-colors">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">calendar_today</span>
<span class="font-label-caps text-label-caps mt-1">Today</span>
</button>
<!-- Inactive Tab: Workouts -->
<button class="flex flex-col items-center justify-center text-on-tertiary-fixed-variant active:scale-90 transition-transform hover:text-primary-fixed-dim transition-colors">
<span class="material-symbols-outlined">fitness_center</span>
<span class="font-label-caps text-label-caps mt-1">Workouts</span>
</button>
<!-- Inactive Tab: Profile -->
<button class="flex flex-col items-center justify-center text-on-tertiary-fixed-variant active:scale-90 transition-transform hover:text-primary-fixed-dim transition-colors">
<span class="material-symbols-outlined">person</span>
<span class="font-label-caps text-label-caps mt-1">Profile</span>
</button>
</div>
</nav>
<script>
        // Simple script to handle date selection visuals
        document.addEventListener('DOMContentLoaded', () => {
            const dateButtons = document.querySelectorAll('section.relative button');
            dateButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Reset all
                    dateButtons.forEach(b => {
                        b.classList.remove('bg-primary-fixed-dim', 'text-on-primary-fixed', 'glow-active');
                        b.classList.add('bg-surface-container-low', 'text-on-surface-variant');
                    });
                    // Set active
                    btn.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
                    btn.classList.add('bg-primary-fixed-dim', 'text-on-primary-fixed', 'glow-active');
                });
            });
        });
    </script>
</body></html>